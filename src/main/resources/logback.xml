<!-- author: Kaidan Gustave -->
<configuration>

    <appender name="Simple" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Pattern -->
            <pattern>
                %nopex[%d{HH:mm:ss}] [%level] [%logger{0}]: %msg%n%ex
            </pattern>
        </encoder>
    </appender>

    <!-- Media range URLs are signed credentials; never expose them in debug diagnostics. -->
    <logger name="com.sedmelluq.discord.lavaplayer.source.youtube.YoutubePersistentHttpStream" level="INFO"/>
    <logger name="com.sedmelluq.discord.lavaplayer.tools.io.PersistentHttpStream" level="INFO"/>
    <logger name="com.sedmelluq.discord.lavaplayer.container.playlists" level="INFO"/>
    <logger name="org.apache.http" level="INFO"/>
    <logger name="org.apache.http.wire" level="OFF"/>
    <logger name="org.apache.http.headers" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="Simple"/>
    </root>

</configuration>
